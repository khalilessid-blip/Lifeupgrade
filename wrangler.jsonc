{
  "name": "lifeupgrade1",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-upgrade-db",
      "database_id": "bf14dffd-d134-4495-8461-f6dea1d9caa9"
    }
  ]
}
